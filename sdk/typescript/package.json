{
  "name": "@serpflow/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for SerpFlow, a search control plane for SerpApi",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
