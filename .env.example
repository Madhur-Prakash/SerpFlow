# SerpFlow environment. Copy to .env and edit.
#
#   cp .env.example .env
#
# Nothing here is a production secret. Every value marked CHANGE ME must be
# replaced before deploying anywhere real. No secret is ever committed.

# ---------------------------------------------------------------- service
SERVICE_NAME=serpflow
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/v1

# ------------------------------------------------- execution mode (sec. 21)
#
# The INSTANCE DEFAULT only. A project can set its own mode in Settings, and a
# single search can override it, so this is the floor rather than the rule.
# Precedence: a `test` API key (always mock) > per-request > project > here.
# live   = normal billable execution against SerpApi
# record = execute live AND persist cassettes
# replay = serve from cassettes only, fail loudly on a miss
#
# A `test` API key ALWAYS routes to the deterministic mock regardless of this
# setting. That precedence is absolute and cannot be overridden.
SERPFLOW_MODE=replay

# --------------------------------------------------------------- datastores
POSTGRES_USER=serpflow
POSTGRES_PASSWORD=serpflow
POSTGRES_DB=serpflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://serpflow:serpflow@localhost:5432/serpflow
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# How long a resolved API principal stays cached (section 33).
REDIS_PRINCIPAL_CACHE_TTL=60

KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=serpflow
KAFKA_CONSUMER_GROUP=serpflow-workers
KAFKA_ENABLED=true
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ----------------------------------------------------- object storage (56)
# filesystem works with no extra services, which is why `make dev` needs none.
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_PATH=./.serpflow-objects
# Set STORAGE_BACKEND=s3 and start the `storage` compose profile for MinIO.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=serpflow-payloads
S3_ACCESS_KEY_ID=serpflow
S3_SECRET_ACCESS_KEY=serpflow-secret
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------------------------------------------------------- security
# CHANGE ME before any deployment.
JWT_SECRET=change-me-in-production-this-is-a-local-dev-default
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Server-side pepper for API key HMAC-SHA256. CHANGE ME.
API_KEY_PEPPER=change-me-api-key-pepper-local-dev-only

# Key-encryption key for the credential vault (section 24), base64 of 32 bytes.
# Production should use KMS; self-hosted should use age. CHANGE ME.
CREDENTIAL_KEK=c2VycGZsb3ctbG9jYWwtZGV2LWtlay0zMmJ5dGVzLXh4eA==
CREDENTIAL_KEK_ID=local-dev-kek-v1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=1048576
# Number of reverse proxies in front of the API that append to X-Forwarded-For
# (the bundled nginx = 1). Use 0 when the API is exposed directly, so a
# client-supplied X-Forwarded-For is never trusted to identify a caller.
TRUSTED_PROXY_HOPS=1

# ------------------------------------------------------ startup bootstrap
# Apply Alembic migrations when the API starts. Safe with several replicas:
# guarded by a Postgres advisory lock, so one process migrates and the rest
# wait rather than racing.
RUN_MIGRATIONS_ON_STARTUP=true
# Run the idempotent seed on every API start: existing records are kept, only
# missing data is inserted. Refused automatically when ENVIRONMENT is staging
# or production, because the seed creates demo accounts with a published
# password.
SEED_ON_STARTUP=true

# ------------------------------------------------------------------- email
# Where the action links in outgoing mail point.
FRONTEND_URL=http://localhost:5173

# --- Gmail API (real email) ---------------------------------------------
# Setting these three is all it takes to send for real; nothing else needs
# changing. With GMAIL_CREDENTIALS_B64 empty, mail goes to the log instead,
# which is what keeps `make dev` working with no keys at all.
#
#   1. Create an OAuth client ID of type "Desktop app" in a Google Cloud
#      project with the Gmail API enabled, and download its JSON.
#   2. uv pip install --python .venv -e ".[dev]"
#      python scripts/mint_gmail_token.py path/to/credentials.json
#      Consent as the mailbox that should send, and paste the printed line here.
#
# The token carries the gmail.send scope only, so it cannot read the mailbox it
# sends from. It is a secret: keep it out of commits. While the OAuth consent
# screen is in "Testing" Google expires it after 7 days - publish the app to
# stop that. A send failing with invalid_grant means it needs minting again.
GMAIL_CREDENTIALS_B64=
# The mailbox that consented. Gmail sends from the authorised account
# regardless, so this carries the display name and catches a mismatch early.
GMAIL_SENDER=
EMAIL_FROM_NAME=SerpFlow
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# ------------------------------------------------------- upstream SerpApi
#
# There is no SERPAPI_API_KEY. SerpFlow is bring-your-own-key: each
# organization stores its own SerpApi key in the encrypted credential vault
# (Settings -> Credentials, or POST /v1/credentials), and nothing in the
# platform falls back to a key belonging to this deployment. Searches run on
# the key of whoever ran them, and the credits come off their account.
#
# These two are transport settings, not credentials.
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------- LLM (Groq)
#
# Also bring-your-own-key. An organization that stores a Groq credential plans
# through Groq; one that does not plans with the deterministic selector, which
# costs nothing and is what `make dev` and `make seed` use (section 41).
#
# LLM_PROVIDER and GROQ_API_KEY below are the SELF-HOSTING fallback and are
# consulted only when the organization has brought no key of its own. Leave
# them as they are if other people will use this instance - setting them would
# mean your key answers for organizations that never supplied one. Set them
# only when you run this instance for yourself alone.
#
#   mock  deterministic selector: no network, no key, same plan every time
#   groq  requires GROQ_API_KEY below; falls back to mock if it is unset or fails
LLM_PROVIDER=mock
GROQ_API_KEY=
# Transport and model settings. These apply to every Groq call, including ones
# made with an organization's own key.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
EMBEDDING_DIM=384

# --------------------------------------------------- planner / cache tuning
PLANNER_RETRIEVAL_TOP_K=8
PLANNER_MAX_CANDIDATES=6
PLANNER_MAX_HOPS=4
SEMANTIC_SIMILARITY_THRESHOLD=0.95
CACHE_PARTITION_SCOPE=project
ADAPTIVE_TTL_MIN_SECONDS=300
ADAPTIVE_TTL_MAX_SECONDS=7776000
DEFAULT_BUDGET_ALERT_RATIO=0.8

# ----------------------------------------------------------- record/replay
CASSETTE_DIR=./fixtures/cassettes

# ------------------------------------------------------- retention (sec 55)
RETENTION_STANDARD_DAYS=30
RETENTION_HIGH_PII_DAYS=7

# -------------------------------------------------------- observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE=logs/serpflow.log
LOG_OUTPUT=both
METRICS_ENABLED=true

# ------------------------------------------------------------------ ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://localhost:8000
